---
import ExperimentRow from './ExperimentRow.astro';

interface Experiment {
  title: string;
  slug: string;
}

interface Props {
  experiments: Experiment[];
}

const { experiments } = Astro.props;
---

<section class="experiment-log">
  <div class="section-inner">
    <div class="section-header">
      <h2>Experiment Log</h2>
    </div>

    <ul class="experiment-list">
      {
        experiments.map((exp, i) => (
          <ExperimentRow title={exp.title} slug={exp.slug} index={i} />
        ))
      }
    </ul>
  </div>
</section>

<style>
  .experiment-log {
    background-color: var(--color-bg-section);
    padding: 4rem 2rem;
  }

  .section-inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }

  h2 {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 2.25rem;
    color: #1a1a2e;
  }

  .experiment-list {
    list-style: none;
    border-radius: 4px;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .section-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }

    h2 {
      font-size: 1.75rem;
      margin: 0;
    }
  }
</style>
