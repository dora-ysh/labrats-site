---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>© {year} All Rights Reserved</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-navy);
    padding: 1.4rem 2rem;
  }

  .footer-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .footer-inner p {
    font-family: var(--font-serif);
    color: #fff;
    font-size: 1rem;
  }
</style>
