---
// src/components/Nav.astro
const navLinks = [
  { label: "Home",           href: "/labrats-site/" },
  { label: "About Us",       href: "/labrats-site/about" },
  { label: "Experiment Log", href: "/labrats-site/blog" },
  { label: "Contact",        href: "/labrats-site/contact" },
];
---

<nav class="nav">
  <a href="/labrats-site/" class="nav-logo">LABRATS</a>

  <ul class="nav-links">
    {navLinks.map(link => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
    <li>
      <a href="/labrats-site/register" class="nav-register">
        Register <span aria-hidden="true">→</span>
      </a>
    </li>
  </ul>
</nav>

<style>
  .nav {
    background: #17305a;
    padding: 0 3rem;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 100;
  }

  .nav-logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 2rem;
    font-weight: 900;
    color: #fff;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: #fff;
    text-decoration: none;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.88;
    transition: opacity 0.2s;
  }

  .nav-links a:hover { opacity: 1; }

  .nav-register {
    border: 2px solid #fff !important;
    border-radius: 999px;
    padding: 0.4rem 1.2rem !important;
    display: flex !important;
    align-items: center;
    gap: 0.4rem;
    transition: background 0.2s, color 0.2s !important;
    opacity: 1 !important;
  }

  .nav-register:hover {
    background: #fff !important;
    color: #17305a !important;
    opacity: 1 !important;
  }

  /* Mobile: hide nav links, show hamburger in future update */
  @media (max-width: 700px) {
    .nav { padding: 0 1.25rem; }
    .nav-links { display: none; }
  }
</style>
