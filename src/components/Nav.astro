---
const navItems = [
  { label: 'Home', href: '' },
  { label: 'Experiment Log', href: 'blog/' },
  { label: 'Kits', href: 'kits/' },
  { label: 'About Us', href: 'about/' },
  { label: 'Contact', href: 'contact/' },
];

const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="header-inner">
    <a href={base} class="logo">LABRATS</a>

    <div class="right-group">
      <nav class="main-nav" aria-label="Main navigation">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={new URL(item.href, base).pathname}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a href="https://anc.ca.apm.activecommunities.com/vancouver/activity/search/detail/619658" class="register-btn">Register</a>

      <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-panel">
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a href={new URL(item.href, base).pathname}>{item.label}</a>
          </li>
        ))
      }
      <li>
        <a href="https://anc.ca.apm.activecommunities.com/vancouver/activity/search/detail/619658" class="mobile-register">Register</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const header = document.querySelector('.site-header');

  toggle?.addEventListener('click', () => {
    const isOpen = header?.classList.toggle('menu-open');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
</script>

<style>
  .site-header {
    background-color: var(--color-navy);
    padding: 1rem 2rem;
    position: relative;
  }

  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.5rem;
    color: #fff;
    text-decoration: none;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .right-group {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .main-nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .main-nav a {
    font-family: var(--font-serif);
    color: #fff;
    text-decoration: none;
    font-size: 1.05rem;
    white-space: nowrap;
  }

  .main-nav a:hover {
    text-decoration: underline;
  }

  .register-btn {
    background: #fff;
    color: var(--color-navy);
    font-family: var(--font-serif);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.8rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    white-space: nowrap;
  }

  .menu-toggle {
    display: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0.25rem;
    flex-direction: column;
    gap: 5px;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
  }

  .mobile-panel {
    display: none;
  }

  @media (max-width: 900px) {
    .main-nav,
    .register-btn {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-panel {
      display: none;
      background: var(--color-navy);
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      padding: 0.75rem 2rem 1.5rem;
    }

    .mobile-panel ul {
      list-style: none;
      display: grid;
      gap: 0.75rem;
    }

    .mobile-panel a {
      color: #fff;
      text-decoration: none;
      font-family: var(--font-serif);
    }

    .site-header.menu-open .mobile-panel {
      display: block;
    }
  }
</style>
