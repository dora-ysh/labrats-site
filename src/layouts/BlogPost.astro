---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
type Props = CollectionEntry<'blog'>['data'];
const {
  title,
  description,
  pubDate,
  heroImage,
  author,
  time,
  difficulty,
  ageRange,
  tags,
} = Astro.props;
---
<BaseLayout title={`${title} — LABRATS`} description={description}>
  <section class="post-page">
    <div class="post-inner">
      <h1>{title}</h1>
      <div class="byline">
        {author && <p>By: {author}</p>}
        <p>Date of Experiment: <FormattedDate date={pubDate} /></p>
      </div>
      {
        heroImage && (
          <div class="hero-image">
            <Image width={1020} height={510} src={heroImage} alt="" />
          </div>
        )
      }
      {
        (time || difficulty || ageRange) && (
          <div class="info-block">
            <h2>Experiment Information</h2>
            <ul>
              {time && <li>Time: {time}</li>}
              {difficulty && <li>Difficulty: {difficulty}</li>}
              {ageRange && <li>Age Range: {ageRange}</li>}
            </ul>
          </div>
        )
      }
      <div class="prose">
        <slot />
      </div>
      {tags && tags.length > 0 && (
        <p class="post-tags">{tags.map((tag) => `#${tag}`).join(' ')}</p>
      )}
    </div>
  </section>
</BaseLayout>
<style>
  .post-page {
    background-color: var(--color-bg-section);
    padding: 3.5rem 2rem 5rem;
  }
  .post-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 2.75rem;
    color: #1a1a2e;
    margin-bottom: 1.5rem;
  }
  .byline {
    margin-bottom: 2rem;
  }
  .byline p {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: #1a1a2e;
    line-height: 1.6;
  }
  .hero-image {
    margin-bottom: 2rem;
  }
  .hero-image :global(img) {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.3rem;
    color: #1a1a2e;
    text-decoration: underline;
    margin-bottom: 0.75rem;
  }
  .info-block {
    margin-bottom: 2rem;
  }
  .info-block ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .info-block li {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: #1a1a2e;
    margin-bottom: 0.35rem;
  }
  .prose :global(p) {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.7;
    color: #1a1a2e;
    margin-bottom: 1.25em;
  }
  .prose :global(h2) {
    text-decoration: underline;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.3rem;
    margin-top: 1.75em;
    margin-bottom: 0.75em;
  }
  .prose :global(h3) {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.15rem;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.25em;
    padding-left: 1.5em;
    font-family: var(--font-serif);
  }
  .prose :global(li) {
    margin-bottom: 0.5em;
  }
  .prose :global(img) {
    width: 100%;
    margin: 1.5em 0;
    border-radius: 8px;
    height: auto;
  }
  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding-left: 1em;
    border-left: 3px solid var(--color-navy);
    font-style: italic;
  }
  .prose :global(iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
    border-radius: 8px;
    margin: 1.5em 0;
  }
  .post-tags {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    color: #999;
    margin-top: 2rem;
  }
  @media (max-width: 600px) {
    h1 {
      font-size: 2rem;
    }
  }
</style>
