---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperimentLogFull from '../../components/ExperimentLogFull.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const experiments = posts.map((post) => ({
  title: post.data.title,
  slug: post.id,
  time: post.data.time,
  difficulty: post.data.difficulty,
  tags: post.data.tags,
}));
---

<BaseLayout title="Experiment Log — LABRATS" description="Browse every LABRATS experiment.">
  <ExperimentLogFull experiments={experiments} />
</BaseLayout>
