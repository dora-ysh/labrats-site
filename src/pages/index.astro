---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ExperimentLogSection from '../components/ExperimentLogSection.astro';
import OurProgramSection from '../components/OurProgramSection.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const experiments = posts.map((post) => ({
  title: post.data.title,
  slug: post.id,
}));
---
<BaseLayout title="LABRATS">
  <Hero />
  <ExperimentLogSection experiments={experiments} />
  <OurProgramSection
    description="At Kerrisdale Community Centre, we run a STEM program featuring hands-on experiments and activities in biology, physics, and chemistry for children aged 9–12. Led by high-achieving students with advanced subject knowledge, the course also features a talk given by a university engineering or science student."
    learnMoreUrl="https://anc.ca.apm.activecommunities.com/vancouver/activity/search/detail/619658"
    locationName="Kerrisdale Community Centre"
    addressLine1="5851 West Blvd, Vancouver, BC, Canada"
    addressLine2="V6M 3W9"
    mapEmbedUrl="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2605.281940203503!2d-123.15930182369799!3d49.233143571385355!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5486737b74f58363%3A0x2b0fbce0f7da7c0!2sKerrisdale%20Community%20Centre!5e0!3m2!1sen!2sca!4v1783484436059!5m2!1sen!2sca"
  />
</BaseLayout>
