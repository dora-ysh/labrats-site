---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Science Kits — LABRATS" description="LABRATS science kits — coming soon.">
  <section class="kits-page">
    <div class="section-inner">
      <h1>Science Kits</h1>
      <p>Coming soon...</p>
      <p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p>
    </div>
  </section>
</BaseLayout>

<style>
  .kits-page {
    background-color: var(--color-bg-light);
    padding: 4rem 2rem 5rem;
    min-height: 50vh;
  }

  .section-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  h1 {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 2.5rem;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  p {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: #333;
  }
</style>
